        if (e.target.closest('#yk-gear-btn')) {
            menuOpen = !menuOpen;
            const menu = document.getElementById('yk-menu');
            if (menu) menu.classList.toggle('open', menuOpen);
            return;
        }
 
        // Close Button
        if (e.target.closest('#yk-close')) {
            menuOpen = false;
            const menu = document.getElementById('yk-menu');
            if (menu) menu.classList.remove('open');
            return;
        }
 
        // Tab switches
        const tab = e.target.closest('.yk-tab');
        if (tab) {
            document.querySelectorAll('.yk-tab').forEach(t => t.classList.remove('on'));
            document.querySelectorAll('.yk-pane').forEach(p => p.classList.remove('on'));
            tab.classList.add('on');
            const pane = document.querySelector(`.yk-pane[data-pane="${tab.dataset.tab}"]`);
            if (pane) pane.classList.add('on');
            return;
        }
    });
 
    // ── Toggle switches ──
    document.addEventListener('change', e => {
        const input = e.target;
        if (!input.hasAttribute('data-key')) return;
        const key = input.dataset.key;
        config[key] = input.checked;
 
        if (key === 'speedHack') input.checked ? startSpeedHack() : stopSpeedHack();
        if (key === 'rapidFire') input.checked ? startRapidFire() : stopRapidFire();
        if (key === 'bunnyHop') input.checked ? startBunnyHop() : stopBunnyHop();
        if (key === 'autoStrafe') input.checked ? startAutoStrafe() : stopAutoStrafe();
        if (key === 'infiniteJump' && input.checked) startInfiniteJump();
        if (key === 'spinBot') input.checked ? startSpinBot() : stopSpinBot();
        if (key === 'antiAFK') input.checked ? startAntiAFK() : stopAntiAFK();
        if (key === 'autoRespawn') input.checked ? startAutoRespawn() : stopAutoRespawn();
        if (key === 'gameSpeedEnabled') {
            if (input.checked) GameSpeedEngine.enable(config.gameSpeed);
            else GameSpeedEngine.disable();
        }
        if (key === 'esp') {
            config.wireframe = input.checked;
            config.xray = input.checked;
            const wf = document.querySelector('[data-key="wireframe"]');
            const xr = document.querySelector('[data-key="xray"]');
            if (wf) wf.checked = input.checked;
            if (xr) xr.checked = input.checked;
        }
        if (key === 'crosshairCustom') document.getElementById('yk-crosshair-custom')?.classList.toggle('on', input.checked);
        if (key === 'statsOverlay') document.getElementById('yk-stats')?.classList.toggle('on', input.checked);
 
        // Nekoking overlays
        const rave = document.getElementById('yk-rave-overlay');
        if (rave) rave.style.display = config.raveMode ? 'block' : 'none';
 
        const colorOverlay = document.getElementById('yk-color-overlay');
        if (colorOverlay) {
            colorOverlay.style.display = config.colorMod ? 'block' : 'none';
            colorOverlay.style.backgroundColor = config.colorModColor;
            colorOverlay.style.opacity = config.colorModOpacity;
        }
 
        const chaos = document.getElementById('yk-chaos-overlay');
        if (chaos) chaos.style.display = config.chaosMode ? 'block' : 'none';
 
        if (key === 'performanceMode') document.body.style.imageRendering = input.checked ? 'pixelated' : '';
        if (key === 'adRemover' && input.checked) removeAds();
    });
 
    // ── Sliders ──
    document.addEventListener('input', e => {
        const slider = e.target;
        if (!slider.hasAttribute('data-slider')) return;
        const key = slider.dataset.slider;
        const val = parseFloat(slider.value);
        config[key] = val;
        const display = document.getElementById(`sv-${key}`);
        if (display) display.textContent = val % 1 === 0 ? val : val.toFixed(key === 'colorModOpacity' ? 2 : 1);
        if (key === 'gameSpeed' && config.gameSpeedEnabled) GameSpeedEngine.enable(val);
        if (key === 'colorModOpacity' && config.colorMod) {
            const overlay = document.getElementById('yk-color-overlay');
            if (overlay) overlay.style.opacity = val;
        }
    });
 
    // ── Dragging logic ──
    let dragging = false, dx = 0, dy = 0;
    document.addEventListener('mousedown', e => {
        const header = e.target.closest('#yk-header');
        if (!header || e.target.classList.contains('yk-close')) return;
        const menu = document.getElementById('yk-menu');
        if (!menu) return;
        dragging = true;
        const r = menu.getBoundingClientRect();
        dx = e.clientX - r.left;
        dy = e.clientY - r.top;
    });
    document.addEventListener('mousemove', e => {
        if (!dragging) return;
        const menu = document.getElementById('yk-menu');
        if (!menu) return;
        menu.style.left = (e.clientX - dx) + 'px';
        menu.style.top = (e.clientY - dy) + 'px';
    });
    document.addEventListener('mouseup', () => dragging = false);
 
    // ── INSERT Key Bind (Capture Phase, bypass block) ──
    window.addEventListener('keydown', e => {
        if (e.key === 'Insert') {
            e.preventDefault();
            e.stopPropagation();
            menuOpen = !menuOpen;
            const menu = document.getElementById('yk-menu');
            if (menu) menu.classList.toggle('open', menuOpen);
        }
    }, true);
 
    // ============================================
    // INIT & DOM MONITORING
    // ============================================
    function init() {
        // Monitor DOM to ensure GUI stays present even if game script refreshes document.body
        GameSpeedEngine._origSetInterval(() => {
            if (document.body) {
                createGUI();
            }
        }, 1000);
    }
 
    init();
 
} catch (err) {
    console.error('[2v2.io MOD] Fatal initialization error:', err);
}
 
})();
