    function processOutgoing(bytes) {
        if (bytes.length < 1) return bytes;
 
        if (config.noRecoil && bytes.length >= 8) {
            if (bytes[0] === 0x05 || bytes[0] === 0x06) {
                const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
