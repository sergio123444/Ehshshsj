        if (type === 'message') {
            const self = this;
            const wrappedListener = function(event) {
                const processedEvent = processIncomingEvent(event);
                if (processedEvent === null) return;
                listener.call(self, processedEvent);
            };
            if (!this._messageListeners) this._messageListeners = new Map();
            this._messageListeners.set(listener, wrappedListener);
            return origAddEventListener.call(this, type, wrappedListener, options);
