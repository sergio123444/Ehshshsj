    };
 
    const origRemoveEventListener = OrigWS.prototype.removeEventListener;
    OrigWS.prototype.removeEventListener = function(type, listener, options) {
        if (type === 'message' && this._messageListeners && this._messageListeners.has(listener)) {
            const wrapped = this._messageListeners.get(listener);
            this._messageListeners.delete(listener);
            return origRemoveEventListener.call(this, type, wrapped, options);
        }
        return origRemoveEventListener.call(this, type, listener, options);
    };
 
    // 3. Hook onmessage using prototype property descriptor
    const descriptor = Object.getOwnPropertyDescriptor(OrigWS.prototype, 'onmessage');
    if (descriptor && descriptor.set) {
        Object.defineProperty(OrigWS.prototype, 'onmessage', {
            get() {
                return this._userOnMessage || null;
            },
